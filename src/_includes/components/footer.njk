      <!-- Navigation -->
      <div>
        <h4 class="text-n-cream text-sm tracking-[0.35em] uppercase font-semibold mb-6">Explore</h4>
        <ul class="space-y-3">
          <li><a href="{{ "/#about" | url }}" class="text-n-warm/60 hover:text-n-red text-base transition-colors">About</a></li>
          <li><a href="{{ "/menus.html" | url }}" class="text-n-warm/60 hover:text-n-red text-base transition-colors">Menu</a></li>
          <li><a href="{{ "/private-parties-and-event-catering-near-hudson-yards.html" | url }}" class="text-n-warm/60 hover:text-n-red text-base transition-colors">Parties &amp; Catering</a></li>
          <li><a href="{{ "/gallery.html" | url }}" class="text-n-warm/60 hover:text-n-red text-base transition-colors">Gallery</a></li>
          <li><a href="{{ "/#reservations" | url }}" class="text-n-warm/60 hover:text-n-red text-base transition-colors">Reservations</a></li>
          <li><a href="{{ "/#gift-cards" | url }}" class="text-n-warm/60 hover:text-n-red text-base transition-colors">Gift Cards</a></li>
          <li><a href="{{ "/#contact" | url }}" class="text-n-warm/60 hover:text-n-red text-base transition-colors">Contact</a></li>
          <li><a href="{{ "/employment/" | url }}" class="text-n-warm/60 hover:text-n-red text-base transition-colors">Employment</a></li>
        </ul>
      </div>

      <!-- Visit -->
      <div>
        <h4 class="text-n-cream text-sm tracking-[0.35em] uppercase font-semibold mb-6">Visit Us</h4>
        <address class="not-italic text-n-warm/60 text-base space-y-1">
          <p>{{ client.address.street }}</p>
          <p>{{ client.address.neighborhood }}, {{ client.address.city }}, {{ client.address.state }} {{ client.address.zip }}</p>
          <p class="mt-4"><a href="tel:{{ client.phone }}" class="hover:text-n-red transition-colors">{{ client.phone }}</a></p>
        </address>
        <div class="mt-6 space-y-1">
          {% for slot in client.hours %}
            <p class="text-n-muted text-sm">{{ slot.days }}: <span class="text-n-warm/60">{{ slot.hours }}</span></p>
          {% endfor %}
        </div>
        <a href="{{ client.googleMapsUrl }}" target="_blank" rel="noopener noreferrer" class="inline-block mt-6 text-n-red hover:text-n-cream text-sm tracking-[0.2em] uppercase transition-colors border-b border-n-red/40 pb-px">Get Directions &rarr;</a>
      </div>

    </div>

    <div class="border-t border-n-border mt-12 pt-8 flex flex-col md:flex-row justify-between items-center gap-3">
      <p class="text-n-muted text-sm">&copy; {{ global.currentYear }} {{ client.name }}. All Rights Reserved.</p>
      <p class="text-n-muted text-sm">Website designed and hosted by <a href="https://88restaurants.com/features/restaurant_website_design_and_hosting" target="_blank" rel="noopener noreferrer" class="hover:text-n-red transition-colors">88 Restaurants</a></p>
    </div>
  </div>
</footer>
