<footer class="bg-n-surface pt-24">
  <div class="max-w-screen-xl mx-auto px-6 py-16">
    <div class="grid md:grid-cols-3 gap-12">

      <!-- Logo + tagline -->
      <div>
        <a href="{{ "/" | url }}">
          <img src="{{ "/assets/images/logo.png" | url }}" alt="{{ client.name }}" class="h-16 w-auto mb-5" style="filter: invert(1);">
        </a>
        <p class="font-eurostile text-n-muted text-base leading-relaxed mb-6">{{ client.tagline }}</p>
        <div class="flex items-center gap-4">
          <a href="https://www.instagram.com/nittisnyc/" target="_blank" rel="noopener noreferrer" aria-label="Nittis on Instagram" class="text-n-muted hover:text-n-red transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="https://www.facebook.com/nittisnyc" target="_blank" rel="noopener noreferrer" aria-label="Nittis on Facebook" class="text-n-muted hover:text-n-red transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.yelp.com/biz/nittis-new-york" target="_blank" rel="noopener noreferrer" aria-label="Nittis on Yelp" class="text-n-muted hover:text-n-red transition-colors">
            <i class="bi bi-yelp text-xl"></i>
          </a>
          <a href="https://www.tripadvisor.com/Restaurant_Review-g60763-d15398423-Reviews-Nittis-New_York_City_New_York.html" target="_blank" rel="noopener noreferrer" aria-label="Nittis on TripAdvisor" class="text-n-muted hover:text-n-red transition-colors">
            <i class="bi bi-tripadvisor text-xl"></i>
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h4 class="text-n-cream text-sm tracking-[0.35em] uppercase font-semibold mb-6">Explore</h4>
        <ul class="space-y-3">
          <li><a href="{{ "/#about" | url }}" class="text-n-warm/60 hover:text-n-red text-base transition-colors">About</a></li>
          <li><a href="{{ "/menu/" | url }}" class="text-n-warm/60 hover:text-n-red text-base transition-colors">Menu</a></li>
          <li><a href="{{ "/private-parties-and-event-catering-near-hudson-yards/" | url }}" class="text-n-warm/60 hover:text-n-red text-base transition-colors">Parties &amp; Catering</a></li>
          <li><a href="{{ "/gallery/" | url }}" class="text-n-warm/60 hover:text-n-red text-base transition-colors">Gallery</a></li>
          <li><a href="{{ "/#reservations" | url }}" class="text-n-warm/60 hover:text-n-red text-base transition-colors">Reservations</a></li>
          <li><a href="{{ "/#gift-cards" | url }}" class="text-n-warm/60 hover:text-n-red text-base transition-colors">Gift Cards</a></li>
          <li><a href="{{ "/#contact" | url }}" class="text-n-warm/60 hover:text-n-red text-base transition-colors">Contact</a></li>
          <li><a href="{{ "/employment/" | url }}" class="text-n-warm/60 hover:text-n-red text-base transition-colors">Employment</a></li>
        </ul>
      </div>

      <!-- Visit -->
      <div>
        <h4 class="text-n-cream text-sm tracking-[0.35em] uppercase font-semibold mb-6">Visit Us</h4>
        <address class="not-italic text-n-warm/60 text-base space-y-1">
          <p>{{ client.address.street }}</p>
          <p>{{ client.address.neighborhood }}, {{ client.address.city }}, {{ client.address.state }} {{ client.address.zip }}</p>
          <p class="mt-4"><a href="tel:{{ client.phone }}" class="hover:text-n-red transition-colors">{{ client.phone }}</a></p>
        </address>
        <div class="mt-6 space-y-1">
          {% for slot in client.hours %}
            <p class="text-n-muted text-sm">{{ slot.days }}: <span class="text-n-warm/60">{{ slot.hours }}</span></p>
          {% endfor %}
        </div>
        <a href="{{ client.googleMapsUrl }}" target="_blank" rel="noopener noreferrer" class="inline-block mt-6 text-n-red hover:text-n-cream text-sm tracking-[0.2em] uppercase transition-colors border-b border-n-red/40 pb-px">Get Directions &rarr;</a>
      </div>

    </div>

    <div class="border-t border-n-border mt-12 pt-8 flex flex-col md:flex-row justify-between items-center gap-3">
      <p class="text-n-muted text-sm">&copy; {{ global.currentYear }} {{ client.name }}. All Rights Reserved.</p>
      <p class="text-n-muted text-sm">Website designed and hosted by <a href="https://88restaurants.com/features/restaurant_website_design_and_hosting" target="_blank" rel="noopener noreferrer" class="hover:text-n-red transition-colors">88 Restaurants</a></p>
    </div>
  </div>
</footer>
