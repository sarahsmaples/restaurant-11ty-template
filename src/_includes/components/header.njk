<style>
  #site-header {
    transition: background 0.4s ease, border-color 0.4s ease, backdrop-filter 0.4s ease;
  }
  #site-header .nav-link {
    color: #0a0a0a;
    transition: color 0.4s ease;
  }
  #site-header .nav-link:hover {
    color: #c0392b;
  }
  #site-header .header-logo {
    filter: none;
    transition: filter 0.4s ease;
  }
  #site-header.scrolled .header-logo {
    filter: invert(1);
  }
  #site-header .btn-outline {
    color: #0a0a0a;
    border-color: rgba(10,10,10,0.3);
    transition: color 0.4s ease, border-color 0.4s ease;
  }
  #site-header.scrolled {
    background: rgba(10,10,10,0.95) !important;
    border-color: #2a2a2a !important;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  #site-header.scrolled .nav-link {
    color: #ffffff;
  }
  #site-header.scrolled .nav-link:hover {
    color: #c0392b;
  }
  #site-header.scrolled .btn-outline {
    color: rgba(240,235,227,0.6);
    border-color: rgba(240,235,227,0.25);
  }
  #site-header #mobile-menu-button {
    color: #0a0a0a;
    transition: color 0.4s ease;
  }
  #site-header.scrolled #mobile-menu-button {
    color: #ffffff;
  }
</style>

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 border-b border-transparent" style="background: transparent;">
  <div class="max-w-screen-xl mx-auto px-6 flex items-center justify-between h-20">

    <!-- Logo -->
    <a href="{{ "/" | url }}" class="flex-shrink-0">
      <img src="{{ "/assets/images/logo.png" | url }}" alt="{{ client.name }}" class="header-logo h-12 w-auto">
    </a>

    <!-- Mobile toggle -->
    <button id="mobile-menu-button" type="button" class="md:hidden p-2 text-n-black hover:text-n-red transition-colors" aria-label="Open main menu">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"/>
      </svg>
    </button>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-6">
      <a href="{{ "/menu/" | url }}" class="nav-link font-eurostile font-bold text-base lowercase">Menu</a>
      <a href="{{ "/private-parties-and-event-catering-near-hudson-yards/" | url }}" class="nav-link font-eurostile font-bold text-base lowercase">Events</a>
      <a href="{{ "/gallery/" | url }}" class="nav-link font-eurostile font-bold text-base lowercase">Gallery</a>
      <a href="{{ "/#gift-cards" | url }}" class="nav-link font-eurostile font-bold text-base lowercase">Gift Cards</a>
      <a href="{{ "/#contact" | url }}" class="nav-link font-eurostile font-bold text-base lowercase">Contact</a>
      <a href="{{ "/#reservations" | url }}" class="btn-red">Reserve</a>
      <a href="https://order.nittisnyc.com/nittis-italian-restaurant-new-york-city-ny/online_orders/new" target="_blank" rel="noopener noreferrer" class="btn-outline">Order</a>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-n-surface border-t border-n-border px-6 py-6">
    <nav class="flex flex-col gap-5">
      <a href="{{ "/menu/" | url }}" class="nav-link font-eurostile font-bold text-base lowercase">Menu</a>
      <a href="{{ "/private-parties-and-event-catering-near-hudson-yards/" | url }}" class="nav-link font-eurostile font-bold text-base lowercase">Events</a>
      <a href="{{ "/gallery/" | url }}" class="nav-link font-eurostile font-bold text-base lowercase">Gallery</a>
      <a href="{{ "/#gift-cards" | url }}" class="nav-link font-eurostile font-bold text-base lowercase">Gift Cards</a>
      <a href="{{ "/#contact" | url }}" class="nav-link font-eurostile font-bold text-base lowercase">Contact</a>
      <a href="{{ "/#reservations" | url }}" class="btn-red text-center mt-2">Reserve</a>
      <a href="https://order.nittisnyc.com/nittis-italian-restaurant-new-york-city-ny/online_orders/new" target="_blank" rel="noopener noreferrer" class="btn-outline text-center">Order</a>
    </nav>
  </div>
</header>

<script>
  (function () {
    var header = document.getElementById('site-header');

    document.addEventListener('DOMContentLoaded', function () {
      var hero = document.getElementById('hero-wrapper');

      if (!hero) {
        header.classList.add('scrolled');
      } else {
        function getThreshold() {
          return hero.offsetHeight - window.innerHeight;
        }

        function updateHeader() {
          if (window.scrollY > getThreshold()) {
            header.classList.add('scrolled');
          } else {
            header.classList.remove('scrolled');
          }
        }

        window.addEventListener('scroll', updateHeader, { passive: true });
        updateHeader();
      }
    });

    document.getElementById('mobile-menu-button').addEventListener('click', function () {
      document.getElementById('mobile-menu').classList.toggle('hidden');
    });
  })();
</script>
