  {# Lightbox #}
  <div id="lightbox" class="fixed inset-0 z-50 hidden flex-col items-center justify-center" style="background: rgba(0,0,0,0.93);">

    {# Close #}
    <button id="lb-close" aria-label="Close" class="absolute top-5 right-6 w-11 h-11 flex items-center justify-center text-n-muted hover:text-n-cream transition-colors">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>

    {# Image #}
    <img id="lb-img" src="" alt="Nittis Italian Restaurant" class="max-h-[85vh] max-w-[90vw] object-contain select-none">

    {# Prev / Next #}
    <button id="lb-prev" aria-label="Previous image" class="absolute left-4 top-1/2 -translate-y-1/2 w-11 h-11 border border-n-gold/30 flex items-center justify-center text-n-cream hover:border-n-red hover:text-n-red transition-colors" style="background: rgba(10,10,10,0.6);">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    </button>
    <button id="lb-next" aria-label="Next image" class="absolute right-4 top-1/2 -translate-y-1/2 w-11 h-11 border border-n-gold/30 flex items-center justify-center text-n-cream hover:border-n-red hover:text-n-red transition-colors" style="background: rgba(10,10,10,0.6);">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
    </button>

    {# Counter #}
    <p id="lb-counter" class="absolute bottom-5 text-n-muted text-sm tracking-widest"></p>
  </div>

  <script>
    (function () {
      var imgs = Array.from(document.querySelectorAll('.gallery-img'));
      var lb = document.getElementById('lightbox');
      var lbImg = document.getElementById('lb-img');
      var lbCounter = document.getElementById('lb-counter');
      var current = 0;

      function open(index) {
        current = index;
        lbImg.src = imgs[current].src;
        lbCounter.textContent = (current + 1) + ' / ' + imgs.length;
        lb.classList.remove('hidden');
        lb.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function close() {
        lb.classList.add('hidden');
        lb.classList.remove('flex');
        document.body.style.overflow = '';
      }

      function prev() { open((current - 1 + imgs.length) % imgs.length); }
      function next() { open((current + 1) % imgs.length); }

      imgs.forEach(function (img, i) {
        img.addEventListener('click', function () { open(i); });
      });

      document.getElementById('lb-close').addEventListener('click', close);
      document.getElementById('lb-prev').addEventListener('click', prev);
      document.getElementById('lb-next').addEventListener('click', next);

      lb.addEventListener('click', function (e) {
        if (e.target === lb) close();
      });

      document.addEventListener('keydown', function (e) {
        if (lb.classList.contains('hidden')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') prev();
        if (e.key === 'ArrowRight') next();
      });
    })();
  </script>
