  <script>
  (function () {
    var section = document.getElementById('about');
    var colLeft  = document.getElementById('about-col-left');
    var colRight = document.getElementById('about-col-right');
    if (!section || !colLeft || !colRight) return;

    var sectionTop = 0;

    function recalc() {
      sectionTop = section.getBoundingClientRect().top + window.scrollY;
      update();
    }

    function update() {
      var progress = Math.max(0, window.scrollY - sectionTop);
      colLeft.style.transform  = 'translateY(' + (-progress * 0.25) + 'px)';
      colRight.style.transform = 'translateY(' + (progress * 0.25) + 'px)';
    }

    document.addEventListener('DOMContentLoaded', recalc);
    window.addEventListener('load', recalc);
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', recalc);
  })();
  </script>

