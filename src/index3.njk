  {# ── Reviews ───────────────────────────────────────────────────── #}
  <section id="reviews" class="relative z-[20] py-20 overflow-hidden min-h-screen" style="background-image: url('{{ "/assets/images/bg-marble.jpg" | url }}'); background-size: cover; background-position: center;">
    <div class="absolute inset-0 bg-n-black/60"></div>
    <div class="relative z-10 max-w-screen-xl mx-auto px-6 text-center">
      <span class="section-label">Guest Reviews</span>
      <h2 class="section-heading">What Our Guests Say</h2>
      <div class="section-rule"></div>

      {# Sliding carousel — all cards in one track, 3 visible at a time #}
      <div id="reviews-carousel" class="overflow-hidden">
        <div id="reviews-track" class="flex" style="transition: transform 0.5s ease-in-out;">
          {% for review in reviews %}
            <div class="w-full md:w-1/3 flex-shrink-0 px-3 text-left">
              <div class="border border-n-gold/30 px-8 py-8 h-full space-y-5" style="background: rgba(10,10,10,0.45); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);">
                <p class="text-n-warm/85 text-base leading-relaxed">&ldquo;{{ review.text }}&rdquo;</p>
                <div class="pt-4 border-t border-n-gold/20">
                  {% if review.url %}
                    <a href="{{ review.url }}" target="_blank" rel="noopener noreferrer" class="text-n-red hover:text-n-cream text-sm font-semibold tracking-wide transition-colors">&mdash; {{ review.name }}</a>
                  {% else %}
                    <p class="text-n-red text-sm font-semibold tracking-wide">&mdash; {{ review.name }}</p>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      {# Navigation #}
      <div class="flex items-center justify-center gap-8 mt-10">
        <button id="reviews-prev" aria-label="Previous review" class="w-10 h-10 border border-n-gold/30 flex items-center justify-center text-n-cream hover:border-n-red hover:text-n-red transition-colors" style="background: rgba(10,10,10,0.45); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <div class="flex gap-3 items-center">
          {% for i in range(0, reviews | length - 2) %}
            <button class="reviews-dot relative flex items-center justify-center w-11 h-11 transition-colors" data-index="{{ loop.index0 }}" aria-label="Go to position {{ loop.index }}">
              <span class="block w-2 h-2 rounded-full transition-colors {% if loop.first %}bg-n-red{% else %}bg-n-muted{% endif %}"></span>
            </button>
          {% endfor %}
        </div>
        <button id="reviews-next" aria-label="Next review" class="w-10 h-10 border border-n-gold/30 flex items-center justify-center text-n-cream hover:border-n-red hover:text-n-red transition-colors" style="background: rgba(10,10,10,0.45); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>

    </div>
  </section>

  <script>
    (function () {
      var carousel = document.getElementById('reviews-carousel');
      var track = document.getElementById('reviews-track');
      var dots = document.querySelectorAll('.reviews-dot');
      var total = track.children.length;
      var current = 0;

      function getVisible() { return window.innerWidth >= 768 ? 3 : 1; }
      function getMax() { return total - getVisible(); }

      function goTo(index) {
        var max = getMax();
        current = ((index % (max + 1)) + (max + 1)) % (max + 1);
        var cardWidth = carousel.offsetWidth / getVisible();
        track.style.transform = 'translateX(-' + (current * cardWidth) + 'px)';
        dots.forEach(function (dot, i) {
          var span = dot.querySelector('span');
          span.classList.toggle('bg-n-red', i === current);
          span.classList.toggle('bg-n-muted', i !== current);
        });
      }

      document.getElementById('reviews-prev').addEventListener('click', function () { goTo(current - 1); });
      document.getElementById('reviews-next').addEventListener('click', function () { goTo(current + 1); });
      dots.forEach(function (dot) {
        dot.addEventListener('click', function () { goTo(parseInt(dot.dataset.index)); });
      });
      window.addEventListener('resize', function () { goTo(Math.min(current, getMax())); });
    })();
  </script>


